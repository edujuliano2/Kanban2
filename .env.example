# Banco de dados (produção)
DATABASE_URL=
JWT_SECRET=

# URL pública usada nos e-mails e nas notificações
APP_URL=http://localhost:5173
APP_TIMEZONE=America/Sao_Paulo

# Chave usada pelo n8n para consultar os avisos da agenda
NOTIFICATIONS_API_KEY=
NOTIFICATIONS_FAMILY_ID=

# Remetente dos convites
MAIL_FROM="Agenda da Família <agenda@seudominio.com>"
MAIL_FROM_EMAIL=agenda@seudominio.com
MAIL_REPLY_TO=

# Opção 1: SMTP (recomendado para convites de calendário)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Opção 2: Resend (alternativa sem SMTP)
RESEND_API_KEY=
